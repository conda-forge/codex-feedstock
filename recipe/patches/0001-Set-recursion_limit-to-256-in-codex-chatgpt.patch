From 3a0f13fbccf651091fa5214a8e96c27ff6552ef4 Mon Sep 17 00:00:00 2001
From: Pavel Zwerschke <pavelzw@gmail.com>
Date: Tue, 6 Oct 2026 16:51:50 +0200
Subject: [PATCH] Set recursion_limit to 256 in codex-chatgpt

Newer rustc versions (e.g. 1.98 used on conda-forge) overflow the default
query depth limit when computing the layout of connectors::list_connectors().
Backport of https://github.com/openai/codex/pull/49706.
---
 codex-rs/chatgpt/src/lib.rs | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/codex-rs/chatgpt/src/lib.rs b/codex-rs/chatgpt/src/lib.rs
index 057478d..5589621 100644
--- a/codex-rs/chatgpt/src/lib.rs
+++ b/codex-rs/chatgpt/src/lib.rs
@@ -1,3 +1,5 @@
+#![recursion_limit = "256"]
+
 pub mod apply_command;
 mod chatgpt_client;
 pub mod connectors;
-- 
2.53.0

